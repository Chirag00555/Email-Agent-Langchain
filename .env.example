# ==============================================================================
# Personal Gmail Analysis Assistant - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real configuration.
# NEVER commit the real .env file or credentials to version control.
# ==============================================================================

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# SQLite Database Location
DATABASE_PATH=data/email_agent.db

# Google OAuth Paths
# Single Google Cloud Project "Desktop Application" client credentials
GOOGLE_CREDENTIALS_FILE=credentials.json
# Directory where per-account token files are stored (e.g., account_1.json, etc.)
TOKENS_DIR=tokens

# Gmail Accounts Configuration
# Account 1: Job hunting account 1
ACCOUNT_1_EMAIL=jainchirag.cj555@gmail.com
ACCOUNT_1_TYPE=jobs

# Account 2: Dedicated to credit card transaction alerts
ACCOUNT_2_EMAIL=chirag.cj555@gmail.com
ACCOUNT_2_TYPE=transactions

# Account 3: Job hunting account 2
ACCOUNT_3_EMAIL=chirag.work555@gmail.com
ACCOUNT_3_TYPE=jobs

# Broad Pre-Filter Search Queries (Gmail query syntax)
# These broad filters reduce token usage and API calls while avoiding premature rejection.
GMAIL_TRANSACTION_QUERY=(receipt OR transaction OR alert OR charge OR debit OR credit OR payment OR order OR statement)
GMAIL_JOB_QUERY=(interview OR application OR applied OR offer OR assessment OR recruiter OR "status update" OR "next steps" OR rejection)

# Scanning Options
SCAN_LOOKBACK_OVERLAP_HOURS=2
